# REQUIRED: openssl rand -hex 32
BACKEND_API_KEY=replace-me

# Encryption key (empty = auto-generated in data/.secret_key)
SECRET_KEY=

# Web console credentials
SOC_USER=admin
SOC_PASS=change-me

# Auth mode: local | ad
AUTH_MODE=local

# AD admins (comma-separated)
ADMIN_USERNAMES=

# Timezone
TZ=Europe/Moscow
ANALYSIS_TZ=Europe/Moscow

# GeoIP: auto | local | external | none
GEO_PROVIDER=auto

# SIEM connection
SIEM_VERIFY=false
ALLOW_PUBLIC_TARGETS=false

# Detection tuning
BRUTE_FORCE_THRESHOLD=5
OFF_HOURS_START=20
OFF_HOURS_END=8
EXCLUDED_AD_NETS=10.0.101.0/24
TECHNICAL_IPS=10.77.36.11,10.77.1.3,0.0.0.0,127.0.0.1,255.255.255.255,::

# Incidents: minimum risk score to be listed
# 0 = everyone with VPN+AD logins (old behavior)
# 10 = + AD-without-VPN only; 15 = + failed-only;
# 20 = off-hours / multi-geo / combos (default); 40 = medium+
INCIDENT_MIN_SCORE=20

# Data
RETENTION_DAYS=7

# LLM
LLM_TIMEOUT=180

# Telegram proxy (empty = direct). Example: socks5://10.250.1.117:1080
TG_PROXY=

# Login rate limit (requests/min per IP, nginx)
LOGIN_RATE_RPM=5

# Alert re-send cooldown per user, minutes
ALERT_COOLDOWN_MIN=120

# Fetch pagination: max pages (500 events each) per datasource per cycle
FETCH_MAX_PAGES=4

# DB backups: keep N files (daily cron 03:00 + manual via API)
BACKUP_KEEP=14

# Playbook run history retention, days
PLAYBOOK_RUN_DAYS=14